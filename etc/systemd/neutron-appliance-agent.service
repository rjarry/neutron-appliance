[Unit]
Description=Neutron appliance agent
After=network.target
Wants=network.target
# The agent retries configuration failures itself, for as long as it takes.
# Never let systemd give up on it after a burst of restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/neutron-appliance-agent
Restart=always
RestartSec=5
# The agent is NOT load-bearing for forwarding. Once the kernel is configured
# packets flow whether it lives or dies, so an agent failure means
# "configuration frozen", not "traffic down". Do not add a watchdog that
# reboots the VM: that would turn a cosmetic failure into an outage.

[Install]
WantedBy=multi-user.target
