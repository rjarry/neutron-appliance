# The management NIC is addressed by DHCP. NetworkManager is in the CentOS
# minimal base, so let it auto-configure every unconfigured interface rather
# than installing dhcp-all-interfaces' per-interface units.
export DIB_DHCP_NETWORK_MANAGER_AUTO=${DIB_DHCP_NETWORK_MANAGER_AUTO:-true}
